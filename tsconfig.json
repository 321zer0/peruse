{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,

    "sourceMap": true,
    "declaration": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts"
  ]
}
